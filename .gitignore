# .gitignore for Tango

# Environment & secrets
.env
.env.*
!.env.example

# Python
# Global patterns, not per-directory ones. This listed tests/ and
# src/pipeline/ by name, so scripts/__pycache__ was never covered and a .pyc
# was committed. Anchoring to directory names catches every directory,
# including ones that do not exist yet.
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
src/*.egg-info/
*.egg
dist/
build/
.eggs/

# Virtual environment
.tangovenv/
.venv/
venv/
env/

# Pipeline output
output/
*.apkg
pipeline.db
# SQLite writes these two alongside the database in WAL mode, which
# _get_db() enables. They are transient and meaningless without the .db.
pipeline.db-shm
pipeline.db-wal
review.json

# Offline Wiktionary indexes: hundreds of MB each, rebuildable at any time
# with `make dictionary LANGUAGE=<code>`. Never commit these.
dictionaries/

# Logs
logs/
*.log
*.jsonl

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Type checking
.mypy_cache/

# Linting
.ruff_cache/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# spaCy model cache
# Models are downloaded via 'make spacy-model', not committed
*.tar.gz

# Claude Settings
.claude/settings.local.json
# Pronunciation audio cache (ADR-009). Rebuildable, and large in aggregate.
media/

# Card image cache (ADR-009 phase 3). Same reasoning as media/: rebuildable,
# and it grows with every deck. Note this is the cache at the repo root, not
# docs/assets/, which holds committed diagrams.
images/
