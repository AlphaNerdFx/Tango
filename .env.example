# Tango configuration template.
#
# Copy this file to .env and fill in what you need:
#   cp .env.example .env
#
# Nothing in this file is required to run the pipeline. Every value has a
# working default, and MW_API_KEY specifically is optional despite older
# docs implying otherwise -- dictionaryapi.dev is used automatically with
# no key needed. Run `make setup` for a guided walkthrough instead of
# editing this by hand.

# -- Definitions --------------------------------------------------------------

# Merriam-Webster Collegiate API key. Optional. Improves English definition
# and example quality; dictionaryapi.dev is used automatically without one.
# Free registration: https://dictionaryapi.com/register/index.htm
MW_API_KEY=

# Max concurrent definition lookups in flight at once. Default: 5
DEFINITION_FETCH_WORKERS=5

# Seconds to wait for a definition API response before timing out. Default: 8
API_TIMEOUT=8

# Consecutive failures against one definition source before the pipeline
# stops calling it for the rest of the run. Default: 5
CIRCUIT_BREAKER_THRESHOLD=5

# -- Anki -----------------------------------------------------------------

# AnkiConnect URL. Default: http://localhost:8765
ANKI_HOST=http://localhost:8765

# Seconds to wait for AnkiConnect before timing out. Default: 5
ANKI_TIMEOUT=5

# genanki model and deck IDs. NEVER change these after your first import --
# doing so makes Anki treat all existing cards as belonging to a different
# template/deck, permanently breaking review history.
ANKI_MODEL_ID=1607392321
ANKI_DECK_ID=2059400110

# -- Deck duplicate matching ------------------------------------------------

# Fuzzy match score above which a word counts as already in the deck. Default: 90
CONFIDENCE_HIGH=90

# Fuzzy match score below which a word counts as brand new. Default: 60
CONFIDENCE_LOW=60

# Words shorter than this use exact match only. Default: 4
SHORT_WORD_THRESHOLD=4

# -- spaCy ------------------------------------------------------------------

# Overrides every language's spaCy model size uniformly (e.g. "md", "lg").
# Leave unset to use each language's own default -- see language.SPACY_MODELS.
SPACY_MODEL_SIZE_OVERRIDE=

# -- Proxy (youtube-transcript-api) ------------------------------------------

# Optional. Only needed if YouTube starts rate-limiting your IP. See the
# WSL/Troubleshooting wiki pages before choosing a proxy provider.
WEBSHARE_USERNAME=
WEBSHARE_PASSWORD=
PROXY_HTTP_URL=
PROXY_HTTPS_URL=

# -- Translation mode (optional module) --------------------------------------

# Local LibreTranslate server URL, used as a fallback if community mirrors
# are unavailable. Default: http://localhost:5000
LIBRETRANSLATE_URL=http://localhost:5000

# Stable path for argostranslate's downloaded models, recommended on WSL
# where the default path can move between sessions. See the WSL wiki page.
ARGOS_PACKAGES_DIR=

# -- File paths ---------------------------------------------------------------
#
# A relative value here is resolved against the project root, not against the
# directory you happen to run from — otherwise running the pipeline from
# elsewhere silently uses a second, empty database and an unbuilt dictionary
# directory, with nothing raised. Give an absolute path to override that.

DB_PATH=pipeline.db
OUTPUT_DIR=output
REVIEW_FILE=review.json

# Where per-language Wiktionary indexes are built and read from
# (make dictionary LANGUAGE=fr). Hundreds of MB each; keep it off a synced
# or backed-up folder if that matters to you.
DICT_DIR=dictionaries

# Cache for pronunciation audio embedded in cards. Roughly 20 KB per word,
# kept forever, so a word met in a second video is never downloaded twice.
MEDIA_DIR=media

# Pacing for those downloads, in requests per second, and how many may go
# out back-to-back before pacing applies.
#
# Do not raise these casually. upload.wikimedia.org rate-limits per IP:
# measured, about ten requests succeed and every one after that returns 429
# with Retry-After: 11. Exceeding it does not fail loudly — the cards simply
# fall back to a link, and a 406-card run once embedded 13 recordings and
# linked the other 364 without a single error. ARCHITECTURE.md 8.35.
MEDIA_RATE_LIMIT=1.25
MEDIA_BURST=8

# Retries for a rate-limited (429) download, and the longest single wait
# honoured from a Retry-After header. Other failures are not retried: a 404
# means the recording does not exist and the card links out immediately.
MEDIA_MAX_RETRIES=2
MEDIA_MAX_RETRY_WAIT=30

# Seconds to wait for one audio file. Short on purpose — these are small.
MEDIA_TIMEOUT=10
